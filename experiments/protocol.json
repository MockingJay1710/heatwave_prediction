{
  "version": 1,
  "start_date": "2024-01-01",
  "end_date": "2026-09-23",
  "timezone": "UTC",
  "issue_hour_utc": 0,
  "target": "maximum hourly 2m temperature over the UTC day starting at issue time",
  "center": {"latitude": 47.2184, "longitude": -1.5536},
  "radii_km": {"local": 75, "regional": 200},
  "validation_days": 90,
  "evaluation_windows": [
    {"name": "cv_2025_spring", "start": "2025-01-01", "end": "2025-05-01"},
    {"name": "cv_2025_summer", "start": "2025-05-01", "end": "2025-09-01"},
    {"name": "cv_2025_autumn", "start": "2025-09-01", "end": "2026-01-01"},
    {"name": "test_2026", "start": "2026-01-01", "end": "2026-09-24"}
  ],
  "extreme_change_threshold_c": 4.0,
  "warm_quantile_train_only": 0.9,
  "random_state": 42,
  "xgboost": {
    "objective": "reg:squarederror",
    "tree_method": "hist",
    "n_estimators": 1000,
    "learning_rate": 0.03,
    "max_depth": 3,
    "min_child_weight": 5,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_alpha": 0.1,
    "reg_lambda": 5.0,
    "n_jobs": 2,
    "random_state": 42
  },
  "early_stopping_rounds": 50,
  "references": [
    "https://open-meteo.com/en/docs/historical-weather-api",
    "https://scikit-learn.org/stable/modules/cross_validation.html",
    "https://xgboost.readthedocs.io/en/stable/tutorials/param_tuning.html"
  ]
}
